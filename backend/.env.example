# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=500

# Firebase 서비스 계정 키(JSON 전체를 한 줄 문자열로 저장)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후 내용을 복사
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# CORS 허용 도메인 (콤마로 구분, 로컬 개발 시 * 사용 가능)
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend.vercel.app
